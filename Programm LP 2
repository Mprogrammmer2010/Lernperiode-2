
using System;
class Program
{
    static void Main()
    {
        Console.WriteLine("=== Taschenrechner ===");
        double zahl1, zahl2, ergebnis = 0;
        Console.Write("Erste Zahl: ");
        while (!double.TryParse(Console.ReadLine(), out zahl1))
            Console.Write("Ungültig! Erneut eingeben: ");
        Console.Write("Zweite Zahl: ");
        while (!double.TryParse(Console.ReadLine(), out zahl2))
            Console.Write("Ungültig! Erneut eingeben: ");
        Console.WriteLine("Deine Zahlen: " + zahl1 + " und " + zahl2);
        Console.WriteLine("Wähle: plus, minus, mal oder hoch");
        while (true)
        {
            Console.Write("Rechenart: ");
            string wahl = (Console.ReadLine() ?? "").ToLower().Trim();
            switch (wahl)
            {
                case "plus": ergebnis = zahl1 + zahl2; break;
                case "minus": ergebnis = zahl1 - zahl2; break;
                case "mal": ergebnis = zahl1 * zahl2; break;
                case "hoch": ergebnis = Math.Pow(zahl1, zahl2); break;
                default:
                    Console.WriteLine("Ungültige Eingabe!");
                    continue;
            }
            break;
        }
        Console.WriteLine("Ergebnis: " + ergebnis);
        Console.WriteLine("Drücke Enter zum Beenden.");
        Console.ReadLine();
    }
}
