using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("=== Taschenrechner ===");

        while (true)
        {
            double zahl1, zahl2, ergebnis = 0;

            Console.WriteLine();
            Console.WriteLine("Neue Rechnung starten");
            Console.WriteLine("Gib 'ende' ein, um das Programm zu beenden.");

            Console.Write("Erste Zahl: ");
            string eingabe1 = Console.ReadLine() ?? "";

            if (eingabe1.ToLower().Trim() == "ende")
            {
                break;
            }

            while (!double.TryParse(eingabe1, out zahl1))
            {
                Console.Write("Ungültig! Erneut eingeben: ");
                eingabe1 = Console.ReadLine() ?? "";

                if (eingabe1.ToLower().Trim() == "ende")
                {
                    return;
                }
            }

            Console.Write("Zweite Zahl: ");
            string eingabe2 = Console.ReadLine() ?? "";

            if (eingabe2.ToLower().Trim() == "ende")
            {
                break;
            }

            while (!double.TryParse(eingabe2, out zahl2))
            {
                Console.Write("Ungültig! Erneut eingeben: ");
                eingabe2 = Console.ReadLine() ?? "";

                if (eingabe2.ToLower().Trim() == "ende")
                {
                    return;
                }
            }

            Console.WriteLine();
            Console.WriteLine("Wähle eine Rechenart:");
            Console.WriteLine("plus, minus, mal, geteilt oder hoch");

            bool gueltig = false;

            while (!gueltig)
            {
                Console.Write("Rechenart: ");
                string wahl = (Console.ReadLine() ?? "").ToLower().Trim();

                switch (wahl)
                {
                    case "plus":
                        ergebnis = zahl1 + zahl2;
                        gueltig = true;
                        break;

                    case "minus":
                        ergebnis = zahl1 - zahl2;
                        gueltig = true;
                        break;

                    case "mal":
                        ergebnis = zahl1 * zahl2;
                        gueltig = true;
                        break;

                    case "geteilt":
                        if (zahl2 == 0)
                        {
                            Console.WriteLine("Man kann nicht durch 0 teilen!");
                        }
                        else
                        {
                            ergebnis = zahl1 / zahl2;
                            gueltig = true;
                        }
                        break;

                    case "hoch":
                        ergebnis = Math.Pow(zahl1, zahl2);
                        gueltig = true;
                        break;

                    default:
                        Console.WriteLine("Ungültige Eingabe!");
                        break;
                }
            }

            Console.WriteLine();
            Console.WriteLine("Ergebnis: " + ergebnis);
            Console.WriteLine("-------------------------");
        }

        Console.WriteLine();
        Console.WriteLine("Taschenrechner wurde beendet.");
    }
}
